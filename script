local P, V, p = game:GetService("PathfindingService"), game:GetService("VirtualInputManager"), game:GetService("Players").LocalPlayer
local c, h, r = p.Character or p.CharacterAdded:Wait(), p.Character:WaitForChild("Humanoid"), p.Character:WaitForChild("HumanoidRootPart")
local path = P:CreatePath({AgentRadius = 2, AgentHeight = 8, AgentCanJump = true, AgentJumpHeight = 7, Costs = {Water = 1000}})

local function moveToDestination(target: Vector3)
    local start, currentTarget = os.clock(), target
    print(string.format("[Path] Starting search for (%.1f, %.1f, %.1f)", target.X, target.Y, target.Z))

    while os.clock() - start < 10 do
        local ok, err = pcall(function() path:ComputeAsync(r.Position, currentTarget) end)
        if ok and path.Status == Enum.PathStatus.Success then break end
        warn(string.format("[Path] Compute failed (%s) | Distance: %.1f studs. Bisecting...", err or path.Status.Name, (r.Position - currentTarget).Magnitude))
        currentTarget = r.Position:Lerp(currentTarget, 0.5)
        task.wait(0.1)
    end

    if path.Status ~= Enum.PathStatus.Success then return warn(string.format("[Path] Timed out after %.1fs. Target unreachable.", os.clock() - start)) end
    
    local waypoints = path:GetWaypoints()
    print(string.format("[Path] Found valid route! Waypoints: %d | Time taken: %.2fs", #waypoints, os.clock() - start))
    V:SendKeyEvent(true, Enum.KeyCode.LeftShift, false, game)

    for i, w in ipairs(waypoints) do
        if w.Action == Enum.PathWaypointAction.Jump then
            local rp = RaycastParams.new(); rp.FilterDescendantsInstances = {c}; rp.FilterType = Enum.RaycastFilterType.Exclude
            if not workspace:Raycast(r.Position, Vector3.new(0, 6, 0), rp) then h:ChangeState(Enum.HumanoidStateType.Jumping)
            else warn(string.format("[Path] Waypoint %d/%d: Jump blocked by ceiling!", i, #waypoints)) end
        end
        h:MoveTo(w.Position)
        local t = 0
        while t < 1 and (r.Position * Vector3.new(1,0,1) - w.Position * Vector3.new(1,0,1)).Magnitude >= 5 do t += task.wait(0.05) end
        if t >= 1 then
            warn(string.format("[Path] Stuck at Waypoint %d/%d! Backing up & retrying...", i, #waypoints))
            h:MoveTo(r.Position - r.CFrame.LookVector * 4); task.wait(0.4)
            V:SendKeyEvent(false, Enum.KeyCode.LeftShift, false, game)
            return moveToDestination(target)
        end
    end
    V:SendKeyEvent(false, Enum.KeyCode.LeftShift, false, game)
    print("[Path] Destination reached successfully!")
end

moveToDestination(Vector3.new(2210, 27.5, -4170))
