local PathfindingService = game:GetService("PathfindingService")
local Players = game:GetService("Players")

local player = Players.LocalPlayer

-- Base path params (High water cost to prioritize bridges/land)
local pathParams = {
	AgentRadius = 3,
	AgentHeight = 6,
	AgentCanJump = true,
	AgentJumpHeight = 7,
	Costs = { Water = 100 }
}

local path = PathfindingService:CreatePath(pathParams)

local raycastParams = RaycastParams.new()
raycastParams.FilterType = Enum.RaycastFilterType.Exclude

-- Visualizer Setup Folder
local debugFolder = workspace:FindFirstChild("PathDebugFolder") or Instance.new("Folder")
debugFolder.Name = "PathDebugFolder"
debugFolder.Parent = workspace

local function clearDebugVisuals()
	debugFolder:ClearAllChildren()
end

local function createWaypointMarker(pos, isSmoothed)
	local sphere = Instance.new("Part")
	sphere.Shape = Enum.PartType.Ball
	sphere.Size = Vector3.new(1.2, 1.2, 1.2)
	sphere.Position = pos
	sphere.Anchored = true
	sphere.CanCollide = false
	sphere.Material = Enum.Material.Neon
	sphere.Color = isSmoothed and Color3.fromRGB(0, 255, 127) or Color3.fromRGB(255, 60, 60)
	sphere.Transparency = isSmoothed and 0.2 or 0.5
	sphere.Parent = debugFolder
end

local function createPathLine(startPos, endPos)
	local distance = (startPos - endPos).Magnitude
	if distance < 0.1 then return end

	local line = Instance.new("Part")
	line.Size = Vector3.new(0.3, 0.3, distance)
	line.CFrame = CFrame.lookAt(startPos, endPos) * CFrame.new(0, 0, -distance / 2)
	line.Anchored = true
	line.CanCollide = false
	line.Material = Enum.Material.Neon
	line.Color = Color3.fromRGB(0, 255, 127)
	line.Parent = debugFolder
end

local function flatDistanceSq(v1, v2)
	local dx, dz = v1.X - v2.X, v1.Z - v2.Z
	return (dx * dx) + (dz * dz)
end

-- Thick Spherecast Line-Of-Sight Check
local function hasLineOfSight(startPos, endPos, character, hum)
	-- NEVER smooth/shortcut if character is swimming or submerged
	if hum:GetState() == Enum.HumanoidStateType.Swimming or hum.FloorMaterial == Enum.Material.Water then
		return false
	end

	-- Disallow smoothing across large vertical gaps
	if math.abs(endPos.Y - startPos.Y) > 2.5 then
		return false
	end

	raycastParams.FilterDescendantsInstances = {character, debugFolder}
	local direction = endPos - startPos

	-- Spherecast (1.8 studs radius) prevents cutting through boats/walls
	local result = workspace:Spherecast(startPos + Vector3.new(0, 1.5, 0), 1.8, direction, raycastParams)
	return result == nil
end

local function navigateWithVisuals(destPos)
	clearDebugVisuals()

	local char = player.Character or player.CharacterAdded:Wait()
	local hum = char:WaitForChild("Humanoid")
	local hrp = char:WaitForChild("HumanoidRootPart")

	-- Compute initial path
	local success = pcall(path.ComputeAsync, path, hrp.Position, destPos)
	
	-- Fallback: If path failed due to water cost, reset water cost and compute standard route
	if not success or path.Status ~= Enum.PathStatus.Success then
		local fallbackPath = PathfindingService:CreatePath({
			AgentRadius = 3,
			AgentHeight = 6,
			AgentCanJump = true
		})
		pcall(fallbackPath.ComputeAsync, fallbackPath, hrp.Position, destPos)
		path = fallbackPath
	end

	local waypoints = path:GetWaypoints()
	local totalWaypoints = #waypoints
	if totalWaypoints == 0 then return end

	for _, wp in ipairs(waypoints) do
		createWaypointMarker(wp.Position, false)
	end

	local currentIndex = 1
	local previousPosition = hrp.Position

	while currentIndex <= totalWaypoints do
		if hum.Health <= 0 then break end

		local targetIndex = currentIndex

		-- Lookahead Path Smoothing (Strictly skipped underwater)
		for lookAhead = math.min(currentIndex + 3, totalWaypoints), currentIndex + 1, -1 do
			local targetWP = waypoints[lookAhead]
			if targetWP.Action ~= Enum.PathWaypointAction.Jump then
				if hasLineOfSight(hrp.Position, targetWP.Position, char, hum) then
					targetIndex = lookAhead
					break
				end
			end
		end

		currentIndex = targetIndex
		local currentWP = waypoints[currentIndex]

		createWaypointMarker(currentWP.Position, true)
		createPathLine(previousPosition, currentWP.Position)
		previousPosition = currentWP.Position

		-- Force jump if marked OR if submerged and target is above water surface
		local isSwimming = hum:GetState() == Enum.HumanoidStateType.Swimming
		if currentWP.Action == Enum.PathWaypointAction.Jump or (isSwimming and currentWP.Position.Y > hrp.Position.Y + 1) then
			hum:ChangeState(Enum.HumanoidStateType.Jumping)
		end

		hum:MoveTo(currentWP.Position)

		-- Distance check loop with unstick timeout
		local startTime = os.clock()
		local reachThreshold = isSwimming and 16 or 9 -- Relax threshold in water

		while flatDistanceSq(hrp.Position, currentWP.Position) > reachThreshold do
			if hum.Health <= 0 then
				clearDebugVisuals()
				return
			end

			-- Unstick trigger if stuck underwater against boat/wall for > 1.2 seconds
			if os.clock() - startTime > 1.2 then
				if isSwimming then
					hum:ChangeState(Enum.HumanoidStateType.Jumping) -- Push upward out of water
				end
				break
			end
			task.wait(0.03)
		end

		currentIndex += 1
	end

	task.delay(3, clearDebugVisuals)
end

-- Run navigation
navigateWithVisuals(Vector3.new(2210, 27.5, -4170))
