local P, V, p = game:GetService("PathfindingService"), game:GetService("VirtualInputManager"), game:GetService("Players").LocalPlayer
local c = p.Character or p.CharacterAdded:Wait()
local h, r = c:WaitForChild("Humanoid"), c:WaitForChild("HumanoidRootPart")
local path = P:CreatePath({AgentRadius = 2, AgentHeight = 6, AgentCanJump = true, AgentJumpHeight = 6.37, Costs = {Water = 1000}})

local function comp(a, b) return pcall(function() path:ComputeAsync(a, b) end) and path.Status == Enum.PathStatus.Success and path:GetWaypoints() end
local function flat(v) return Vector3.new(v.X, 0, v.Z) end

local function walk(wps)
    for _, w in ipairs(wps) do
        local rp = RaycastParams.new()
        rp.FilterDescendantsInstances, rp.FilterType = {c}, Enum.RaycastFilterType.Exclude
        if not workspace:Raycast(r.Position, Vector3.new(0, 6.5, 0), rp) then h:ChangeState(Enum.HumanoidStateType.Jumping) end
        h:MoveTo(w.Position)
        local t = 0
        while t < 2 and (flat(r.Position) - flat(w.Position)).Magnitude >= 5 do t += task.wait(0.05) end
        if t >= 2 then h:MoveTo(r.Position - r.CFrame.LookVector * 4) task.wait(0.4) return end
    end
    return true
end

local function moveToDestination(dest)
    V:SendKeyEvent(true, Enum.KeyCode.LeftShift, false, game)
    local gt = function(p) return p + (dest - p).Unit * math.min((dest - p).Magnitude, 250) end
    local curT, curW = gt(r.Position), comp(r.Position, gt(r.Position))

    while (flat(r.Position) - flat(dest)).Magnitude > 6 do
        if not curW then task.wait(0.5) curT = gt(r.Position) curW = comp(r.Position, curT) continue end
        local nxtW
        task.spawn(function() if (dest - curT).Magnitude > 6 then nxtW = comp(curT, gt(curT)) end end)
        if walk(curW) then
            while not nxtW and (dest - curT).Magnitude > 6 do task.wait(0.05) end
            curT, curW = gt(r.Position), nxtW
        else curW = nil task.wait(0.2) end
    end
    V:SendKeyEvent(false, Enum.KeyCode.LeftShift, false, game)
end

moveToDestination(Vector3.new(2210, 27.5, -4170))
