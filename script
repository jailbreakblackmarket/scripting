local PathfindingService = game:GetService("PathfindingService")
local Players = game:GetService("Players")

local player = Players.LocalPlayer
local path = PathfindingService:CreatePath({
	AgentRadius = 2,
	AgentHeight = 6,
	AgentCanJump = true,
	AgentJumpHeight = 6.37,
	Costs = { Water = 1000 }
})

local function computePath(startPos, endPos)
	local success = pcall(path.ComputeAsync, path, startPos, endPos)
	return (success and path.Status == Enum.PathStatus.Success) and path:GetWaypoints() or nil
end

local function walkPath(waypoints, hum, hrp)
	for i = 1, #waypoints do
		local wp = waypoints[i]

		if wp.Action == Enum.PathWaypointAction.Jump then
			hum:ChangeState(Enum.HumanoidStateType.Jumping)
		end

		hum:MoveTo(wp.Position)

		-- Efficient event-driven yield with a 2-second timeout safeguard
		local moveThread = task.delay(2, function()
			-- Unstick logic if character gets stuck longer than 2s
			hum:MoveTo(hrp.Position - hrp.CFrame.LookVector * 4)
		end)

		-- Wait for character to reach destination or break if died
		repeat
			local reached = hum.MoveToFinished:Wait()
			local dist = ((hrp.Position - wp.Position) * Vector3.new(1, 0, 1)).Magnitude
		until reached or dist < 4 or hum.Health <= 0

		task.cancel(moveThread)
		if hum.Health <= 0 then return false end
	end
	return true
end

local function moveToDestination(destPos)
	local char = player.Character or player.CharacterAdded:Wait()
	local hum = char:FindFirstChildOfClass("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")

	if not hum or not hrp then return end

	local defaultSpeed = hum.WalkSpeed
	hum.WalkSpeed = defaultSpeed * 1.5 -- Standard Sprint multiplier

	while ((hrp.Position - destPos) * Vector3.new(1, 0, 1)).Magnitude > 6 do
		if hum.Health <= 0 then break end

		local currentPos = hrp.Position
		local offset = destPos - currentPos
		local dist = offset.Magnitude
		local targetSegment = currentPos + (offset.Unit * math.min(dist, 200))

		local waypoints = computePath(currentPos, targetSegment)

		if waypoints then
			if not walkPath(waypoints, hum, hrp) then
				task.wait(0.1)
			end
		else
			task.wait(0.2)
		end
	end

	hum.WalkSpeed = defaultSpeed
end

-- Execute movement
moveToDestination(Vector3.new(2210, 27.5, -4170))
