print("[DEBUG] Script initialized.")

if not game:IsLoaded() then
    print("[DEBUG] Game not loaded yet. Waiting...")
    game.Loaded:Wait()
    task.wait(3)
    print("[DEBUG] Game loaded.")
end

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")
print("[DEBUG] LocalPlayer and PlayerGui initialized:", Player.Name)

-- 1. Attempting Remote Event Firing for Spawn / Police Selection
local spawnRemote = ReplicatedStorage:FindFirstChild("SpawnSelectionSelect", true)
if spawnRemote and spawnRemote:IsA("RemoteEvent") then
    print("[DEBUG] Found SpawnSelectionSelect RemoteEvent at:", spawnRemote:GetFullName())
    
    local ok1, err1 = pcall(function() spawnRemote:FireServer("Police") end)
    print("[DEBUG] FireServer('Police') status:", ok1 and "Success" or "Failed: " .. tostring(err1))
    
    local ok2, err2 = pcall(function() spawnRemote:FireServer(1) end)
    print("[DEBUG] FireServer(1) status:", ok2 and "Success" or "Failed: " .. tostring(err2))
else
    print("[DEBUG] SpawnSelectionSelect RemoteEvent NOT found!")
end

-- 2. UI Module and Loop Handling
local folder = ReplicatedStorage:FindFirstChild("TeamSelect")
if folder then
    print("[DEBUG] Found 'TeamSelect' folder in ReplicatedStorage.")
    local module = folder:FindFirstChild("TeamChooseUI")
    if module then
        print("[DEBUG] Found 'TeamChooseUI' module.")
        local ok, teamSelect = pcall(require, module)

        if ok and type(teamSelect) == "table" then
            print("[DEBUG] Successfully required 'TeamChooseUI' module.")
            
            if type(teamSelect.Hide) == "function" then
                print("[DEBUG] 'Hide' function exists in module. Starting repeat loop...")
                local timeout = os.clock() + 10

                repeat
                    local hideOk, hideErr = pcall(teamSelect.Hide)
                    if not hideOk then
                        print("[DEBUG] Error calling teamSelect.Hide():", hideErr)
                    end
                    
                    task.wait(0.5) -- Increased slightly to prevent spamming debug logs
                    
                    local gui = PlayerGui:FindFirstChild("TeamSelectGui")
                    local character = Player.Character
                    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
                    
                    local guiDisabled = not gui or not gui.Enabled
                    local currentTeamColor = Player.TeamColor
                    local isPoliceTeam = currentTeamColor == BrickColor.new("Bright blue")
                    local isDead = humanoid and humanoid.Health <= 0
                    local timedOut = os.clock() > timeout
                    
                    print(string.format("[DEBUG Loop] Team: %s | GuiDisabled: %s | IsPolice: %s | IsDead: %s", 
                        tostring(currentTeamColor), 
                        tostring(guiDisabled), 
                        tostring(isPoliceTeam), 
                        tostring(isDead)
                    ))
                    
                until guiDisabled or isPoliceTeam or isDead or timedOut
                print("[DEBUG] Exited team selection loop.")
            else
                print("[DEBUG] 'Hide' is not a valid function in TeamChooseUI.")
            end
        else
            print("[DEBUG] Failed to require 'TeamChooseUI'. Error:", tostring(teamSelect))
        end
    else
        print("[DEBUG] 'TeamChooseUI' module missing in TeamSelect folder.")
    end
else
    print("[DEBUG] 'TeamSelect' folder missing in ReplicatedStorage.")
end

-- 3. Character Verification
if not Player.Character then
    print("[DEBUG] Character not found. Waiting for CharacterAdded...")
    Player.CharacterAdded:Wait()
    print("[DEBUG] Character loaded.")
else
    print("[DEBUG] Character already exists.")
end

print("[DEBUG] Script execution completed.")
