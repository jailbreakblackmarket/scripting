local PathfindingService = game:GetService("PathfindingService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local Players = game:GetService("Players")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid") :: Humanoid
local rootPart = character:WaitForChild("HumanoidRootPart") :: BasePart

local SEGMENT_DISTANCE = 300 -- Safe distance for local navmesh resolution

local path = PathfindingService:CreatePath({
    AgentRadius = 2.5,
    AgentHeight = 6,
    AgentCanJump = true,
    AgentJumpHeight = 8,
    Costs = { Water = 1000 }
})

local function safeComputeWaypoints(startPos: Vector3, endPos: Vector3)
    local success, _ = pcall(function()
        path:ComputeAsync(startPos, endPos)
    end)
    
    if success and path.Status == Enum.PathStatus.Success then
        local waypoints = path:GetWaypoints()
        if #waypoints > 0 then
            return waypoints
        end
    end
    return nil
end

local function walkWaypoints(waypoints): boolean
    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.LeftShift, false, game)

    for i, wp in ipairs(waypoints) do
        if wp.Action == Enum.PathWaypointAction.Jump then
            local rp = RaycastParams.new()
            rp.FilterDescendantsInstances = {character}
            rp.FilterType = Enum.RaycastFilterType.Exclude

            local ray = workspace:Raycast(rootPart.Position, Vector3.new(0, 6, 0), rp)
            if not ray then
                humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end

        humanoid:MoveTo(wp.Position)

        local reached = false
        local timeout = 0
        while timeout < 3.5 do
            local distFlat = (Vector3.new(rootPart.Position.X, 0, rootPart.Position.Z) - Vector3.new(wp.Position.X, 0, wp.Position.Z)).Magnitude
            if distFlat < 5 then
                reached = true
                break
            end
            timeout += task.wait(0.05)
        end

        -- Un-stuck maneuver if stuck at a waypoint
        if not reached then
            warn(string.format("[Path] Stuck at waypoint %d/%d. Re-routing...", i, #waypoints))
            humanoid:MoveTo(rootPart.Position - rootPart.CFrame.LookVector * 5)
            task.wait(0.4)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.LeftShift, false, game)
            return false
        end
    end

    return true
end

local function traverseLongDistance(finalDestination: Vector3)
    print("[Path] Starting travel to", finalDestination)

    while true do
        local currentPos = rootPart.Position
        local distToFinal = (Vector3.new(currentPos.X, 0, currentPos.Z) - Vector3.new(finalDestination.X, 0, finalDestination.Z)).Magnitude

        if distToFinal < 8 then
            break
        end

        -- Direct target capped at max local distance
        local moveDir = (finalDestination - currentPos).Unit
        local stepDist = math.min(distToFinal, SEGMENT_DISTANCE)
        local targetPos = currentPos + (moveDir * stepDist)

        -- Compute local segment
        local waypoints = safeComputeWaypoints(currentPos, targetPos)

        -- Raycast ray fallback if pathing fails on unstreamed or open ground
        if not waypoints then
            warn("[Path] Pathfinding compute failed. Attempting direction fallback...")
            local rayParams = RaycastParams.new()
            rayParams.FilterDescendantsInstances = {character}
            rayParams.FilterType = Enum.RaycastFilterType.Exclude
            
            local rayResult = workspace:Raycast(currentPos, moveDir * stepDist, rayParams)
            local fallbackTarget = rayResult and rayResult.Position or targetPos
            
            waypoints = safeComputeWaypoints(currentPos, fallbackTarget)
        end

        if waypoints then
            local success = walkWaypoints(waypoints)
            if not success then
                task.wait(0.2)
            end
        else
            warn("[Path] Retrying step in 0.5s...")
            task.wait(0.5)
        end
    end

    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.LeftShift, false, game)
    print("[Path] Destination reached successfully!")
    return true
end

-- Run Traversal
traverseLongDistance(Vector3.new(2210, 27.5, -4170))
