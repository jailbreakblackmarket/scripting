local PathfindingService = game:GetService("PathfindingService")
local Players = game:GetService("Players")

local player = Players.LocalPlayer

local path = PathfindingService:CreatePath({
	AgentRadius = 2,
	AgentHeight = 6,
	AgentCanJump = true,
	AgentJumpHeight = 6.37,
	Costs = { Water = 1000 }
})

local raycastParams = RaycastParams.new()
raycastParams.FilterType = Enum.RaycastFilterType.Exclude

-- Calculate flat 2D distance squared (avoids expensive math.sqrt)
local function flatDistanceSq(v1, v2)
	local dx = v1.X - v2.X
	local dz = v1.Z - v2.Z
	return (dx * dx) + (dz * dz)
end

-- Checks if character can walk directly to a point without hitting walls
local function hasLineOfSight(startPos, endPos, character)
	raycastParams.FilterDescendantsInstances = {character}
	local direction = endPos - startPos
	local result = workspace:Raycast(startPos, direction, raycastParams)
	return result == nil
end

local function navigateStaticPath(destPos)
	local char = player.Character or player.CharacterAdded:Wait()
	local hum = char:WaitForChild("Humanoid")
	local hrp = char:WaitForChild("HumanoidRootPart")

	-- Compute full path ONCE at start
	local success = pcall(path.ComputeAsync, path, hrp.Position, destPos)
	if not success or path.Status ~= Enum.PathStatus.Success then return end

	local waypoints = path:GetWaypoints()
	local totalWaypoints = #waypoints
	if totalWaypoints == 0 then return end

	local currentIndex = 1

	while currentIndex <= totalWaypoints do
		if hum.Health <= 0 then break end

		-- PATH SMOOTHING: Look ahead to skip unnecessary waypoints if line of sight is clear
		local targetIndex = currentIndex
		for lookAhead = math.min(currentIndex + 4, totalWaypoints), currentIndex + 1, -1 do
			if waypoints[lookAhead].Action ~= Enum.PathWaypointAction.Jump then
				if hasLineOfSight(hrp.Position, waypoints[lookAhead].Position, char) then
					targetIndex = lookAhead
					break
				end
			end
		end

		currentIndex = targetIndex
		local currentWP = waypoints[currentIndex]

		if currentWP.Action == Enum.PathWaypointAction.Jump then
			hum:ChangeState(Enum.HumanoidStateType.Jumping)
		end

		hum:MoveTo(currentWP.Position)

		-- Wait until close enough to waypoint (using 16 = 4^2 studs squared distance)
		while flatDistanceSq(hrp.Position, currentWP.Position) > 16 do
			if hum.Health <= 0 then return end
			task.wait(0.03) -- Low overhead check interval
		end

		currentIndex += 1
	end
end

-- Run static navigation
navigateStaticPath(Vector3.new(2210, 27.5, -4170))
