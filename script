local PathfindingService = game:GetService("PathfindingService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local Players = game:GetService("Players")

local player = Players.LocalPlayer

local function getCharacterParts()
	local char = player.Character or player.CharacterAdded:Wait()
	local hum = char:WaitForChild("Humanoid", 5)
	local hrp = char:WaitForChild("HumanoidRootPart", 5)
	return char, hum, hrp
end

local path = PathfindingService:CreatePath({
	AgentRadius = 2,
	AgentHeight = 6,
	AgentCanJump = true,
	AgentJumpHeight = 6.37,
	Costs = { Water = 1000 }
})

local function computePath(startPos, endPos)
	local success, err = pcall(function()
		path:ComputeAsync(startPos, endPos)
	end)
	if success and path.Status == Enum.PathStatus.Success then
		return path:GetWaypoints()
	end
	return nil
end

local function flatVector(v)
	return Vector3.new(v.X, 0, v.Z)
end

local function walkPath(waypoints, char, hum, hrp)
	for _, wp in ipairs(waypoints) do
		-- Trigger jump only if path explicitly marks waypoint as a jump point
		if wp.Action == Enum.PathWaypointAction.Jump then
			hum:ChangeState(Enum.HumanoidStateType.Jumping)
		end

		hum:MoveTo(wp.Position)

		local timeElapsed = 0
		while timeElapsed < 2 and (flatVector(hrp.Position) - flatVector(wp.Position)).Magnitude >= 5 do
			timeElapsed += task.wait(0.05)
			if hum.Health <= 0 then return false end
		end

		-- Unstick mechanism if blocked for > 2 seconds
		if timeElapsed >= 2 then
			hum:MoveTo(hrp.Position - hrp.CFrame.LookVector * 4)
			task.wait(0.4)
			return false
		end
	end
	return true
end

local function moveToDestination(destPos)
	local char, hum, hrp = getCharacterParts()
	if not char or not hum or not hrp then return end

	-- Hold shift to sprint (if game supports standard input sprint)
	VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.LeftShift, false, game)

	while (flatVector(hrp.Position) - flatVector(destPos)).Magnitude > 6 do
		if hum.Health <= 0 then break end

		-- Chunk long paths to avoid PathfindingService distance limits (max 250 studs)
		local currentPos = hrp.Position
		local distanceToDest = (destPos - currentPos).Magnitude
		local targetSegment = currentPos + (destPos - currentPos).Unit * math.min(distanceToDest, 200)

		local waypoints = computePath(currentPos, targetSegment)

		if waypoints then
			local completed = walkPath(waypoints, char, hum, hrp)
			if not completed then
				task.wait(0.1) -- Pause briefly before recalculating path if stuck
			end
		else
			task.wait(0.3) -- Retry computing if initial path calculation fails
		end
	end

	VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.LeftShift, false, game)
end

-- Execute movement
moveToDestination(Vector3.new(2210, 27.5, -4170))
