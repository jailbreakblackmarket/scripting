local P, p, RS = game:GetService("PathfindingService"), game:GetService("Players").LocalPlayer, game:GetService("ReplicatedStorage")

print("[DEBUG] Script initialized.")

-- Helper function to visualize destination points in game
local function createDebugVisual(position, color)
    local part = Instance.new("Part")
    part.Size = Vector3.new(1.5, 0.2, 1.5)
    part.Position = position
    part.Anchored = true
    part.CanCollide = false
    part.Material = Enum.Material.Neon
    part.Color = color or Color3.fromRGB(255, 0, 0)
    part.Parent = workspace
    game:GetService("Debris"):AddItem(part, 10) -- Cleanup after 10 seconds
end

local char = p.Character or p.CharacterAdded:Wait()
print("[DEBUG] Character found:", char.Name)

local wp = {{1793, 25, -4110}, {2225, 24, -4050}, {2278, 24, -4110}, {2225, 27, -4165}}
local root = char:WaitForChild("HumanoidRootPart", 5)
local hum = char:WaitForChild("Humanoid", 5)

if not root or not hum then 
    warn("[DEBUG ERROR] HumanoidRootPart or Humanoid missing!")
    return 
end

print("[DEBUG] Root & Humanoid validated. Selecting team...")

local gui = p:WaitForChild("PlayerGui"):WaitForChild("TeamSelectGui", 5)
local btn = gui and gui:FindFirstChild("Police", true)
if btn and getconnections then
    print("[DEBUG] Firing police team selection connections...")
    for _, c in ipairs(getconnections(btn.MouseButton1Click)) do c:Fire() end
    for _, c in ipairs(getconnections(btn.Activated)) do c:Fire() end
else
    warn("[DEBUG WARNING] Police team button or getconnections not found.")
end

print("[DEBUG] Requesting spawn selection...")
RS.SpawnSelectionUpdateSpawnData:FireServer()
RS.SpawnSelectionSelect:FireServer("PoliceOutpost")

-- Wait for respawn/teleport update if team selection triggers a character reload
char = p.CharacterAdded:Wait()
root = char:WaitForChild("HumanoidRootPart", 10)
hum = char:WaitForChild("Humanoid", 10)
print("[DEBUG] Character loaded at spawn position:", root.Position)

local function walkto(target)
    print("[DEBUG] Starting walkto target:", target)
    createDebugVisual(target, Color3.fromRGB(0, 255, 0)) -- Green for walkto points
    
    repeat 
        hum:MoveTo(target) 
        task.wait(8) 
        print("[DEBUG] Re-issuing walkto MoveTo. Current distance:", (root.Position - target).Magnitude)
    until (root.Position - target).Magnitude < 4 or hum.Health <= 0
    
    print("[DEBUG] Reached walkto target or died.")
end

local function walk(target)
    print("[DEBUG] Starting pathfinding walk target:", target)
    createDebugVisual(target, Color3.fromRGB(0, 100, 255)) -- Blue for pathfinding final goal
    
    local attempts = 0
    while (root.Position - target).Magnitude > 10 and hum.Health > 0 do
        attempts = attempts + 1
        print("[DEBUG] Pathfinding attempt #" .. attempts)
        
        local path = P:CreatePath()
        path:ComputeAsync(root.Position, target)
        print("[DEBUG] Path status:", path.Status)
        
        if path.Status == Enum.PathStatus.Success then
            local waypoints = path:GetWaypoints()
            print("[DEBUG] Calculated waypoints count:", #waypoints)
            
            for idx, w in ipairs(waypoints) do
                createDebugVisual(w.Position, Color3.fromRGB(255, 165, 0)) -- Orange for path steps
                
                if w.Action == Enum.PathWaypointAction.Jump then 
                    print("[DEBUG] Jump required at waypoint:", idx)
                    hum.Jump = true 
                end
                
                hum:MoveTo(w.Position)
                hum.MoveToFinished:Wait()
                print("[DEBUG] Reached waypoint:", idx, "/", #waypoints)
            end
        else
            warn("[DEBUG WARNING] Path computation failed! Retrying...")
            task.wait(1)
        end
    end
    print("[DEBUG] Completed pathfinding walk.")
end

print("[DEBUG] Beginning movement sequence...")
walk(Vector3.new(1793, 25, -4050))

for i, coords in ipairs(wp) do 
    print("[DEBUG] Processing waypoint array index:", i)
    walkto(Vector3.new(unpack(coords))) 
end

print("[DEBUG] Script finished successfully.")
