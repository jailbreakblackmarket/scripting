local P, V, p = game:GetService("PathfindingService"), game:GetService("VirtualInputManager"), game:GetService("Players").LocalPlayer
local c = p.Character or p.CharacterAdded:Wait()
local h, r = c:WaitForChild("Humanoid"), c:WaitForChild("HumanoidRootPart")
local path = P:CreatePath({AgentRadius = 1.85, AgentHeight = 6.13, AgentCanJump = true, AgentJumpHeight = 7.27, Costs = {Water = 1000}})

local function safeCompute(startPos: Vector3, targetPos: Vector3)
    if not pcall(function() path:ComputeAsync(startPos, targetPos) end) or path.Status ~= Enum.PathStatus.Success then return nil end
    return path:GetWaypoints()
end

local function walkWaypoints(wps)
    for i, w in ipairs(wps) do
        local rp = RaycastParams.new()
        rp.FilterDescendantsInstances, rp.FilterType = {c}, Enum.RaycastFilterType.Exclude
        
        -- Permanent jumping logic with ceiling clearance safety
        if not workspace:Raycast(r.Position, Vector3.new(0, 6.5, 0), rp) then
            h:ChangeState(Enum.HumanoidStateType.Jumping)
        end
        
        h:MoveTo(w.Position)
        local t = 0
        while t < 2 and (r.Position * Vector3.new(1,0,1) - w.Position * Vector3.new(1,0,1)).Magnitude >= 5 do t += task.wait(0.05) end
        if t >= 2 then
            warn("[Db] Stuck", i)
            h:MoveTo(r.Position - r.CFrame.LookVector * 4) task.wait(0.4)
            return false
        end
    end
    return true
end

local function moveToDestination(dest: Vector3)
    V:SendKeyEvent(true, Enum.KeyCode.LeftShift, false, game)
    
    local currTarget = r.Position + (dest - r.Position).Unit * math.min((dest - r.Position).Magnitude, 250)
    local currWps = safeCompute(r.Position, currTarget)

    while (r.Position * Vector3.new(1,0,1) - dest * Vector3.new(1,0,1)).Magnitude > 6 do
        if not currWps then
            warn("[Db] Unreachable step. Retrying...")
            task.wait(0.5)
            currTarget = r.Position + (dest - r.Position).Unit * math.min((dest - r.Position).Magnitude, 250)
            currWps = safeCompute(r.Position, currTarget)
            continue
        end

        -- Calculate next chunk asynchronously in background while walking current chunk
        local nextWps = nil
        local prefetchThread = task.spawn(function()
            local remainingDist = (dest - currTarget).Magnitude
            if remainingDist > 6 then
                local nextTarget = currTarget + (dest - currTarget).Unit * math.min(remainingDist, 250)
                nextWps = safeCompute(currTarget, nextTarget)
            end
        end)

        local success = walkWaypoints(currWps)
        
        if success then
            if not nextWps and coroutine.status(prefetchThread) ~= "dead" then
                repeat task.wait(0.05) until nextWps or coroutine.status(prefetchThread) == "dead"
            end
            currWps = nextWps
            currTarget = r.Position + (dest - r.Position).Unit * math.min((dest - r.Position).Magnitude, 250)
        else
            currWps = nil
            task.wait(0.2)
        end
    end
    
    V:SendKeyEvent(false, Enum.KeyCode.LeftShift, false, game)
    print("[Db] Reached Final!")
end

moveToDestination(Vector3.new(2210, 27.5, -4170))
