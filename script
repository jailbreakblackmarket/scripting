local PathfindingService = game:GetService("PathfindingService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local Players = game:GetService("Players")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid") :: Humanoid
local rootPart = character:WaitForChild("HumanoidRootPart") :: BasePart

local SEGMENT_DISTANCE = 300

local path = PathfindingService:CreatePath({
    AgentRadius = 2.5,
    AgentHeight = 6,
    AgentCanJump = true,
    AgentJumpHeight = 8,
    Costs = { Water = 1000 }
})

local function safeComputeWaypoints(startPos: Vector3, endPos: Vector3)
    local success, _ = pcall(function()
        path:ComputeAsync(startPos, endPos)
    end)
    
    if success and path.Status == Enum.PathStatus.Success then
        local waypoints = path:GetWaypoints()
        if #waypoints > 0 then
            return waypoints
        end
    end
    
    -- Fallback: Raycast along vector direction if pathfinding engine fails
    local moveDir = (endPos - startPos).Unit
    local dist = (endPos - startPos).Magnitude
    local rayParams = RaycastParams.new()
    rayParams.FilterDescendantsInstances = {character}
    rayParams.FilterType = Enum.RaycastFilterType.Exclude

    local rayResult = workspace:Raycast(startPos, moveDir * dist, rayParams)
    local fallbackTarget = rayResult and rayResult.Position or endPos

    local successFallback, _ = pcall(function()
        path:ComputeAsync(startPos, fallbackTarget)
    end)
    
    if successFallback and path.Status == Enum.PathStatus.Success then
        return path:GetWaypoints()
    end

    return nil
end

local function getTargetPosition(fromPos: Vector3, finalDestination: Vector3): Vector3
    local distToFinal = (Vector3.new(fromPos.X, 0, fromPos.Z) - Vector3.new(finalDestination.X, 0, finalDestination.Z)).Magnitude
    local moveDir = (finalDestination - fromPos).Unit
    local stepDist = math.min(distToFinal, SEGMENT_DISTANCE)
    return fromPos + (moveDir * stepDist)
end

local function walkWaypoints(waypoints): boolean
    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.LeftShift, false, game)

    for i, wp in ipairs(waypoints) do
        if wp.Action == Enum.PathWaypointAction.Jump then
            local rp = RaycastParams.new()
            rp.FilterDescendantsInstances = {character}
            rp.FilterType = Enum.RaycastFilterType.Exclude

            local ray = workspace:Raycast(rootPart.Position, Vector3.new(0, 6, 0), rp)
            if not ray then
                humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end

        humanoid:MoveTo(wp.Position)

        local reached = false
        local timeout = 0
        while timeout < 3.5 do
            local distFlat = (Vector3.new(rootPart.Position.X, 0, rootPart.Position.Z) - Vector3.new(wp.Position.X, 0, wp.Position.Z)).Magnitude
            if distFlat < 5 then
                reached = true
                break
            end
            timeout += task.wait(0.05)
        end

        if not reached then
            warn(string.format("[Path] Stuck at waypoint %d/%d. Re-routing...", i, #waypoints))
            humanoid:MoveTo(rootPart.Position - rootPart.CFrame.LookVector * 5)
            task.wait(0.4)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.LeftShift, false, game)
            return false
        end
    end

    return true
end

local function traverseLongDistance(finalDestination: Vector3)
    print("[Path] Starting seamless travel to", finalDestination)

    -- 1. Initial computation for first segment
    local currentTarget = getTargetPosition(rootPart.Position, finalDestination)
    local currentWaypoints = safeComputeWaypoints(rootPart.Position, currentTarget)

    while true do
        local currentPos = rootPart.Position
        local distToFinal = (Vector3.new(currentPos.X, 0, currentPos.Z) - Vector3.new(finalDestination.X, 0, finalDestination.Z)).Magnitude

        if distToFinal < 8 then
            break
        end

        if not currentWaypoints then
            warn("[Path] No valid route for current segment. Retrying in 0.5s...")
            task.wait(0.5)
            currentTarget = getTargetPosition(rootPart.Position, finalDestination)
            currentWaypoints = safeComputeWaypoints(rootPart.Position, currentTarget)
            continue
        end

        -- 2. Pre-fetch next segment in parallel while walking current segment
        local nextWaypoints = nil
        local prefetchThread = task.spawn(function()
            local nextTarget = getTargetPosition(currentTarget, finalDestination)
            nextWaypoints = safeComputeWaypoints(currentTarget, nextTarget)
        end)

        -- 3. Walk current segment
        local success = walkWaypoints(currentWaypoints)

        if success then
            -- Wait for background pre-fetch to finish if not completed yet
            if not nextWaypoints and coroutine.status(prefetchThread) ~= "dead" then
                repeat task.wait(0.05) until nextWaypoints or coroutine.status(prefetchThread) == "dead"
            end

            -- Advance targets
            currentWaypoints = nextWaypoints
            currentTarget = getTargetPosition(rootPart.Position, finalDestination)
        else
            -- Re-evaluate route from current position if stuck
            task.wait(0.2)
            currentTarget = getTargetPosition(rootPart.Position, finalDestination)
            currentWaypoints = safeComputeWaypoints(rootPart.Position, currentTarget)
        end
    end

    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.LeftShift, false, game)
    print("[Path] Destination reached successfully!")
    return true
end

-- Run Traversal
traverseLongDistance(Vector3.new(2210, 27.5, -4170))
